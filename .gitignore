# Local agent state — never commit
.claude/worktrees/
.worktrees/

# Business-sensitive specs / local notes — never commit to the public repo
docs/private/

# OS / editor noise
.DS_Store
*.swp

# Python bytecode cache (from running the bundled check scripts)
__pycache__/
*.pyc

# .NET build/metrics/mutation artifacts from the gate-test fixtures.
# (Fixtures under gate-tests/ are compiled only by gate-selftest.yml.)
gate-tests/**/bin/
gate-tests/**/obj/
gate-tests/**/StrykerOutput/
*.Metrics.xml

# Local session artifact written by /handoff, read by /pickup — never committed.
.claude/handoff.md

# Derived handoff overview, regenerated by scripts/lib/handoff-index.sh on every
# /handoff and /pickup. The per-branch .claude/handoff-<branch>.md files are the
# committed source of truth; this index is only a view of them.
.claude/handoffs.md

# Subagent-driven-development scratch workspace (ledgers, briefs, review packages) — never committed.
.superpowers/
