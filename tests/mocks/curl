#!/usr/bin/env bash
#
# curl — stand-in for the real curl in Layer-1 fixture tests.
#
# Echoes $CURL_MOCK_FIXTURE. Captures the request body (-d) to
# $CURL_MOCK_BODY_LOG and the argv to $CURL_MOCK_LOG when those are set, so a
# test can assert what was SENT and not only what came back.
#
# Also drains stdin. azdo_set_tags passes credentials via `curl -K -`, and the
# mock must consume that config rather than leave the writer blocked on a pipe.
# Nothing read from stdin is ever logged: it carries the PAT.
#
# Seams:
#   CURL_MOCK_FAIL   when "1", exit 22 (curl's HTTP-error exit under -f) with no
#                    stdout, so a test can drive a caller's failure path.
#   CURL_MOCK_FAIL_PATTERN
#                    same, but only when argv contains this substring — a script
#                    that calls two endpoints needs one of them to fail (#517:
#                    /credits 403s for a key without management rights).
#   CURL_MOCK_FIXTURE_MAP
#                    file of "<substring>\t<fixture>" lines; the first substring
#                    found in argv selects the response. Falls back to
#                    CURL_MOCK_FIXTURE, which is required when no map is set.
set -euo pipefail
IFS=$'\n\t'

if [[ -z "${CURL_MOCK_FIXTURE_MAP:-}" ]]; then
  : "${CURL_MOCK_FIXTURE:?CURL_MOCK_FIXTURE must be set when using the curl mock}"
fi

argv="$( IFS=' '; printf '%s' "$*" )"
[[ -n "${CURL_MOCK_LOG:-}" ]] && printf '%s\n' "$argv" >> "$CURL_MOCK_LOG"

# Consume the config on stdin when -K - was passed, and discard it.
[[ "$argv" == *"-K -"* ]] && cat >/dev/null

if [[ "${CURL_MOCK_FAIL:-}" == "1" ]] \
   || [[ -n "${CURL_MOCK_FAIL_PATTERN:-}" && "$argv" == *"$CURL_MOCK_FAIL_PATTERN"* ]]; then
  printf 'curl: (22) The requested URL returned error: 403\n' >&2
  exit 22
fi

if [[ -n "${CURL_MOCK_BODY_LOG:-}" ]]; then
  prev=""
  for a in "$@"; do
    [[ "$prev" == "-d" ]] && printf '%s\n' "$a" >> "$CURL_MOCK_BODY_LOG"
    prev="$a"
  done
fi

if [[ -n "${CURL_MOCK_FIXTURE_MAP:-}" && -r "${CURL_MOCK_FIXTURE_MAP}" ]]; then
  while IFS=$'\t' read -r pattern fixture || [[ -n "$pattern" ]]; do
    [[ -z "$pattern" ]] && continue
    if [[ "$argv" == *"$pattern"* ]]; then
      cat "$fixture"
      exit 0
    fi
  done < "$CURL_MOCK_FIXTURE_MAP"
fi

cat "${CURL_MOCK_FIXTURE:?no CURL_MOCK_FIXTURE_MAP entry matched and no fallback fixture set}"
