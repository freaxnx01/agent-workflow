#!/usr/bin/env bash
#
# sudo — stand-in for sudo in the agent-boundary Layer-1 tests.
#
# Accepts the one form the driver uses, `sudo -n -u awf-agent <cmd> <args...>`,
# appends its argv to $SUDO_LOG and runs <cmd> with the environment reduced the
# way the real sudoers drop-in reduces it (env_reset + env_keep). It does NOT
# define the production allowlist — docker/azp-agent/sudoers-awf-agent does, and
# tests/run-azp-agent-dockerfile-tests.sh pins it.
#
# Env:
#   SUDO_LOG        file the argv of every call is appended to.
#   SUDO_MOCK_DENY  "1" makes every call fail the way a missing rule does.
#   SUDO_MOCK_KEEP  comma-separated extra variable names to pass through. Test
#                   seam only: a stub entry point needs its own mock's
#                   configuration, which the real allowlist would drop.
#
# Exit codes: the command's own; 1 when the call is refused or malformed.
set -euo pipefail
IFS=$'\n\t'

argv="$(IFS=' '; printf '%s' "$*")"
printf '%s\n' "$argv" >> "${SUDO_LOG:-/dev/null}"

want_user=''
while (( $# )); do
  case "$1" in
    -n) shift ;;
    -u) want_user="${2:-}"; shift 2 ;;
    --) shift; break ;;
    *)  break ;;
  esac
done

if [[ "${SUDO_MOCK_DENY:-}" == "1" ]]; then
  printf 'sudo: a password is required\n' >&2
  exit 1
fi
if [[ "$want_user" != "awf-agent" ]]; then
  printf 'sudo: refusing to run as %q\n' "$want_user" >&2
  exit 1
fi
if (( $# == 0 )); then
  printf 'sudo: no command given\n' >&2
  exit 1
fi

env_args=("PATH=$PATH" "HOME=${HOME:-/tmp}")
keep=(CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY MODEL MAX_TURNS)
IFS=',' read -r -a extra <<< "${SUDO_MOCK_KEEP:-}"
IFS=$'\n\t'
for name in "${keep[@]}" "${extra[@]}"; do
  [[ -n "$name" && -n "${!name+set}" ]] || continue
  env_args+=("$name=${!name}")
done
# AWF_* is the boundary's own configuration (workspace root, CLI path): the real
# rule passes it because the trusted driver sets it, not the agent.
for name in $(compgen -e); do
  [[ "$name" == AWF_* ]] || continue
  env_args+=("$name=${!name}")
done

exec env -i "${env_args[@]}" "$@"
